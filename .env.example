# Pentia v4 — Archivo de ejemplo de variables de entorno
# Copia como .env y personaliza según tus necesidades

# ── Ollama (LLM) ──────────────────────────────────────────
OLLAMA_MODEL=qwen2.5-coder:1.5b
# Modelo ligero por defecto (~1 GB) para equipos comunes; cambia a
# qwen2.5-coder (7B) u otro si tu equipo lo soporta.
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEMPERATURE=0.1

# ── Web UI ─────────────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_RELOAD=false

# ── APIs externas (opcional) ──────────────────────────────
SHODAN_API_KEY=your_key_here
VIRUSTOTAL_API_KEY=your_key_here
CVEDB_API_KEY=your_key_here

# ── Paths y configuración ──────────────────────────────────
NUCLEI_TEMPLATES=/usr/share/nuclei-templates
OUTPUT_DIR=./results
LOG_LEVEL=INFO

# ── Machine Learning (si instalaste INSTALL_HEAVY=1) ──────
CHROMADB_HOST=localhost
# NOTE (4.0.1): era 8000 y chocaba con WEB_PORT=8000 de arriba.
CHROMADB_PORT=8001
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
