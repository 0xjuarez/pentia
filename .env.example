# Pentia v4 — Archivo de ejemplo de variables de entorno
# Copia como .env y personaliza según tus necesidades

# ── Ollama (LLM) ──────────────────────────────────────────
OLLAMA_MODEL=qwen2.5-coder
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEMPERATURE=0.1

# ── Web UI ─────────────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_RELOAD=false

# ── APIs externas (opcional) ──────────────────────────────
SHODAN_API_KEY=your_key_here
VIRUSTOTAL_API_KEY=your_key_here
CVEDB_API_KEY=your_key_here

# ── Paths y configuración ──────────────────────────────────
NUCLEI_TEMPLATES=/usr/share/nuclei-templates
OUTPUT_DIR=./results
LOG_LEVEL=INFO

# ── Machine Learning (si instalaste INSTALL_HEAVY=1) ──────
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
